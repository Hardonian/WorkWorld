{
  "name": "workworld",
  "version": "0.1.0",
  "private": true,
  "description": "WorkWorld — executable professional-work simulations with inspectable assessment evidence (small-business operations apprenticeship).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "eval": "tsx scripts/eval-runner.ts",
    "baseline": "tsx scripts/run-baseline.ts",
    "negatives": "tsx scripts/run-negative-controls.ts",
    "db:up": "bash scripts/db-up.sh",
    "db:down": "bash scripts/db-down.sh",
    "db:test": "vitest run tests/db",
    "release-gate": "node scripts/release-gate.mjs",
    "validate:task-state": "tsx scripts/validate-task-state.ts",
    "doctor": "bash scripts/doctor.sh"
  },
  "dependencies": {
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/pg": "8.15.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
