# WorkWorld example configuration. Contains NO credentials and must never contain any.
# Copy to .env.local and fill in values only where a real integration is intended.

# --- Runtime ---
# demo | hosted
WORKWORLD_MODE=demo
# demo persistence: memory | file
WORKWORLD_STORE=file
WORKWORLD_DATA_DIR=./var/demo-data

# --- Hosted (Supabase/Postgres) — required only when WORKWORLD_MODE=hosted ---
# Hosted paths stay DISABLED (and return a clear unavailable state) unless both are set.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# Server-only. Never NEXT_PUBLIC_*, never shipped to the client, never logged.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Agent providers (optional) ---
# OpenAI API adapter (live). Absent key => live runs reported as externally blocked.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Local OpenAI-compatible endpoint (e.g. Ollama).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# --- Experiment budget guard (integer minor units of declared currency) ---
WORKWORLD_BUDGET_CURRENCY=CAD
WORKWORLD_BUDGET_MINOR=0
