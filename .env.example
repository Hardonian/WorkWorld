# WorkWorld example configuration. Contains NO credentials and must never contain any.
# Copy to .env.local and fill in values only where a real integration is intended.

# --- Runtime ---
# demo | hosted
WORKWORLD_MODE=demo
# demo persistence: memory | file
WORKWORLD_STORE=file
WORKWORLD_DATA_DIR=./var/demo-data

# --- Hosted (Supabase/Postgres) — required only when WORKWORLD_MODE=hosted ---
# Hosted paths stay DISABLED (and return a clear unavailable state) unless both are set.
# Server-side connection URL (never exposed to the browser).
# SUPABASE_URL=
# Browser-safe Project URL and publishable key for cookie-based Supabase Auth.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy compatibility only; prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
# SUPABASE_ANON_KEY=
# Server-only. Never NEXT_PUBLIC_*, never shipped to the client, never logged.
# SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection for the durable EventStore; server-only.
# DATABASE_URL=
# Supabase root CA PEM; use deploy/supabase/prod-ca-2021.crt as the value.
# WORKWORLD_DB_CA_CERT=
# Set only after migrations, Auth, and RLS smoke tests succeed.
# WORKWORLD_HOSTED_STORE_WIRED=false

# Required to issue signed, scoped agent certificates; 32+ characters, server-only.
# WORKWORLD_CERTIFICATION_SIGNING_KEY=

# --- Agent providers (optional) ---
# OpenAI API adapter (live). Absent key => live runs reported as externally blocked.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Local OpenAI-compatible endpoint (e.g. Ollama).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# --- Experiment budget guard (integer minor units of declared currency) ---
WORKWORLD_BUDGET_CURRENCY=CAD
WORKWORLD_BUDGET_MINOR=0
